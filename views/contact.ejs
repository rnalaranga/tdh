<%- include('partials/header', { page: 'contact', title: 'Contact Us — TD HANDYMAN', description: 'Get a free quote for your property maintenance needs in South East Melbourne.' }) %>

<!-- ─── PAGE HERO ────────────────────────────────────────────────────────── -->
<section class="page-hero">
  <div class="page-hero-bg">
    <img src="/images/service_painting.png" alt="Contact TD HANDYMAN" />
  </div>
  <div class="container page-hero-content reveal">
    <span class="eyebrow">Get In Touch</span>
    <h1 class="section-title">Start Your <em>Project</em></h1>
  </div>
</section>

<!-- ─── CONTACT SECTION ──────────────────────────────────────────────────── -->
<section class="section" style="padding: 0; min-height: 100vh; position: relative; display: flex; align-items: center; justify-content: center;">
  
  <!-- Cinematic Background -->
  <div style="position: absolute; inset: 0; z-index: 0;">
    <img src="/images/hero_handyman.png" alt="Contact Background" style="width: 100%; height: 100%; object-fit: cover; filter: grayscale(20%);" />
    <div style="position: absolute; inset: 0; background: linear-gradient(to right, rgba(3,10,13,0.9) 0%, rgba(3,10,13,0.7) 100%);"></div>
  </div>

  <div class="container" style="position: relative; z-index: 1; padding: 100px 0;">
    <div class="contact-grid">
      
      <!-- Contact Info -->
      <div class="contact-info reveal">
        <h2 class="section-title" style="font-size: 3rem; margin-bottom: 40px; color: #fff;">Let's Create<br><em style="background: linear-gradient(135deg, var(--accent), var(--accent-alt)); -webkit-background-clip: text; -webkit-text-fill-color: transparent;">Something Exceptional</em></h2>
        
        <div class="contact-info-list">
          <div class="contact-info-item" style="color: #fff;">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="var(--accent)" stroke-width="2"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 13a19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 3.61 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L7.91 9.91a16 16 0 0 0 6.29 6.29l1.06-1.06a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
            <div class="contact-info-text">
              <strong style="color: #fff; font-family: var(--font-heading); font-size: 1.1rem;">Phone</strong>
              <a href="tel:+61415414631" style="color: rgba(255,255,255,0.7);">0415 414 631</a>
            </div>
          </div>
          
          <div class="contact-info-item" style="color: #fff;">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="var(--accent)" stroke-width="2"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
            <div class="contact-info-text">
              <strong style="color: #fff; font-family: var(--font-heading); font-size: 1.1rem;">Email</strong>
              <a href="mailto:tdmnptyltd@gmail.com" style="color: rgba(255,255,255,0.7);">tdmnptyltd@gmail.com</a>
            </div>
          </div>
          
          <div class="contact-info-item" style="color: #fff;">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="var(--accent)" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
            <div class="contact-info-text">
              <strong style="color: #fff; font-family: var(--font-heading); font-size: 1.1rem;">Service Area</strong>
              <span style="color: rgba(255,255,255,0.7);">South East Melbourne, Victoria</span>
            </div>
          </div>
        </div>
      </div>

      <!-- Contact Form -->
      <div class="contact-form-wrapper reveal" style="transition-delay: 200ms; background: rgba(3, 10, 13, 0.6); backdrop-filter: blur(20px); border: 1px solid rgba(255,255,255,0.1); padding: 50px 40px; border-radius: var(--radius-lg); box-shadow: 0 30px 60px rgba(0,0,0,0.4);">
        <form action="/contact" method="POST" id="contactForm">
          <% if (typeof success !== 'undefined' && success) { %>
            <div style="background: rgba(15, 138, 126, 0.2); border: 1px solid var(--accent); color: #fff; padding: 16px; margin-bottom: 24px; text-align: center; border-radius: 4px;">
              Thank you! Your inquiry has been sent successfully.
            </div>
          <% } %>
          <% if (typeof error !== 'undefined' && error) { %>
            <div style="background: rgba(255, 0, 0, 0.2); border: 1px solid red; color: #ff6b6b; padding: 16px; margin-bottom: 24px; text-align: center; border-radius: 4px;">
              Sorry, there was an error sending your message. Please call us directly.
            </div>
          <% } %>

          <div class="form-group">
            <input type="text" id="name" name="name" class="form-control-glass" placeholder="Your Name" required>
          </div>
          
          <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 20px;">
            <div class="form-group">
              <input type="email" id="email" name="email" class="form-control-glass" placeholder="Email Address" required>
            </div>
            <div class="form-group">
              <input type="tel" id="phone" name="phone" class="form-control-glass" placeholder="Phone Number" required>
            </div>
          </div>
          
          <div class="form-group">
            <select id="service" name="service" class="form-control-glass" required style="appearance: none;">
              <option value="" disabled selected>Select Service</option>
              <option value="Landscaping">Landscaping</option>
              <option value="Retaining Walls">Retaining Walls</option>
              <option value="Rendering">Rendering</option>
              <option value="Tiling">Tiling</option>
              <option value="General Maintenance">General Maintenance</option>
              <option value="Painting">Painting</option>
              <option value="Irrigation Systems">Irrigation Systems</option>
              <option value="Modern Wall Moulding">Modern Wall Moulding</option>
            </select>
          </div>
          
          <div class="form-group">
            <textarea id="message" name="message" class="form-control-glass" rows="4" placeholder="Project Details" required style="resize: vertical;"></textarea>
          </div>
          
          <button type="submit" class="btn btn-primary" style="width: 100%; margin-top: 10px;">Send Inquiry</button>
        </form>
      </div>
      
    </div>
  </div>
</section>

<%- include('partials/footer') %>
