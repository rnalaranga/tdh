<%- include('partials/header') %>
<script>document.body.classList.add('light-nav');</script>

<!-- Page Hero -->
<section class="page-hero" id="contact-hero">
  <div class="container page-hero-inner">
    <span class="section-label">Get In Touch</span>
    <h1 class="page-title">Let's Talk About<br /><em style="font-style:italic; color: var(--green-pale);">Your Garden</em></h1>
    <p class="page-description">Get a free, no-obligation quote from our expert team. We'll get back to you within 24 hours.</p>
  </div>
</section>

<!-- Contact Section -->
<section class="section contact-section" id="contact-main">
  <div class="container">
    <div class="contact-grid">

      <!-- Contact Info -->
      <div class="contact-info reveal-left">
        <h2>We'd Love to Hear<br />From You</h2>
        <p>Whether you have a quick question, want to discuss a project, or are ready to book a service — our friendly team is here to help. Get in touch by phone, email, or fill in the form.</p>

        <div class="contact-details">
          <div class="contact-detail-item">
            <div class="contact-detail-icon">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 13a19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 3.61 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L7.91 9.91a16 16 0 0 0 6.29 6.29l1.06-1.06a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
            </div>
            <div class="contact-detail-text">
              <h4>Phone</h4>
              <a href="tel:+61400000000" id="contact-phone-link">+61 400 000 000</a>
            </div>
          </div>

          <div class="contact-detail-item">
            <div class="contact-detail-icon">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
            </div>
            <div class="contact-detail-text">
              <h4>Email</h4>
              <a href="mailto:info@tdhandyman.com.au" id="contact-email-link">info@tdhandyman.com.au</a>
            </div>
          </div>

          <div class="contact-detail-item">
            <div class="contact-detail-icon">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
            </div>
            <div class="contact-detail-text">
              <h4>Service Area</h4>
              <p>Servicing all states and territories across Australia</p>
            </div>
          </div>

          <div class="contact-detail-item">
            <div class="contact-detail-icon">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
            </div>
            <div class="contact-detail-text">
              <h4>Business Hours</h4>
              <p>Monday – Saturday: 7:00am – 6:00pm<br/>Sunday: By appointment</p>
            </div>
          </div>
        </div>

        <!-- Map Embed (placeholder) -->
        <div style="border-radius: var(--radius-lg); overflow: hidden; height: 220px; background: linear-gradient(135deg, var(--green-dark), var(--green-mid)); display: flex; align-items: center; justify-content: center; box-shadow: var(--shadow-md);">
          <div style="text-align: center; color: rgba(255,255,255,0.8);">
            <div style="font-size: 2.5rem; margin-bottom: 12px;">📍</div>
            <div style="font-family: var(--font-heading); font-size: 1.1rem; font-weight: 600; color: white; margin-bottom: 6px;">Australia Wide</div>
            <div style="font-size: 0.85rem; opacity: 0.75;">Servicing all states & territories</div>
          </div>
        </div>
      </div>

      <!-- Contact Form -->
      <div class="contact-form-wrap reveal-right">
        <h3 class="form-title">Get a Free Quote</h3>
        <p class="form-subtitle">Fill in the form below and we'll get back to you within 24 hours.</p>

        <% if (success) { %>
        <div class="form-success" id="form-success-msg" role="alert">
          <p>🌿 Thank you! Your enquiry has been sent successfully. We'll be in touch soon!</p>
        </div>
        <% } %>

        <% if (error) { %>
        <div class="form-error" id="form-error-msg" role="alert">
          ⚠️ <%= error %>
        </div>
        <% } %>

        <form action="/contact" method="POST" id="contact-form" novalidate>
          <div class="form-row">
            <div class="form-group">
              <label for="contact-name">Full Name <span style="color: var(--terracotta);">*</span></label>
              <input
                type="text"
                id="contact-name"
                name="name"
                placeholder="e.g. Sarah Mitchell"
                required
                autocomplete="name"
              />
            </div>
            <div class="form-group">
              <label for="contact-email">Email Address <span style="color: var(--terracotta);">*</span></label>
              <input
                type="email"
                id="contact-email"
                name="email"
                placeholder="your@email.com"
                required
                autocomplete="email"
              />
            </div>
          </div>

          <div class="form-row">
            <div class="form-group">
              <label for="contact-phone">Phone Number</label>
              <input
                type="tel"
                id="contact-phone"
                name="phone"
                placeholder="+61 400 000 000"
                autocomplete="tel"
              />
            </div>
            <div class="form-group">
              <label for="contact-service">Service Required</label>
              <select id="contact-service" name="service">
                <option value="">Select a service...</option>
                <option value="lawn-care">Lawn Mowing & Care</option>
                <option value="landscaping">Landscaping Design</option>
                <option value="garden-maintenance">Garden Maintenance</option>
                <option value="pruning">Tree & Hedge Pruning</option>
                <option value="irrigation">Irrigation Systems</option>
                <option value="garden-cleanup">Garden Clean-Up</option>
                <option value="other">Other / Not Sure</option>
              </select>
            </div>
          </div>

          <div class="form-group">
            <label for="contact-message">Your Message <span style="color: var(--terracotta);">*</span></label>
            <textarea
              id="contact-message"
              name="message"
              placeholder="Tell us about your garden, the work needed, your location, and any other details that would help us provide an accurate quote..."
              required
            ></textarea>
          </div>

          <button type="submit" class="btn btn-primary" id="contact-submit-btn" style="width: 100%; justify-content: center; padding: 16px 32px; font-size: 1rem;">
            Send My Enquiry
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M22 2L11 13M22 2l-7 20-4-9-9-4 20-7z"/></svg>
          </button>

          <p style="font-size: 0.8rem; color: var(--text-muted); text-align: center; margin-top: 16px;">
            🔒 Your details are kept private and never shared.
          </p>
        </form>
      </div>

    </div>
  </div>
</section>

<%- include('partials/footer') %>
