<%- include('partials/header') %>

<!-- ============================
     HOME — HERO
     ============================ -->
<section class="hero-editorial" id="home-hero">
  <div class="hero-editorial-grid">
    
    <!-- Left: Content -->
    <div class="hero-editorial-content reveal-left">
      <div class="hero-editorial-badge">
        <span class="badge-dot"></span>
        Trusted Across Australia
      </div>

      <h1 class="hero-editorial-title">
        Bespoke <br />
        <span class="highlight">Landscapes</span> & <br />
        Garden Design
      </h1>

      <p class="hero-editorial-description">
        Elevating Australian outdoor spaces through meticulous garden maintenance, expert landscaping, and elegant design.
      </p>

      <div class="hero-editorial-actions">
        <a href="/contact" class="btn btn-primary" id="hero-cta-quote">
          Request a Quote
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
        </a>
        <a href="/services" class="hero-editorial-link" id="hero-cta-services">
          Explore our services
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
        </a>
      </div>
      
      <!-- Stats inside content -->
      <div class="hero-editorial-stats">
        <div class="stat-item">
          <div class="stat-number"><span data-count="500" data-suffix="+">0+</span></div>
          <div class="stat-label">Projects Completed</div>
        </div>
        <div class="stat-item">
          <div class="stat-number"><span data-count="12" data-suffix="+">0+</span></div>
          <div class="stat-label">Years Experience</div>
        </div>
        <div class="stat-item">
          <div class="stat-number"><span data-count="98" data-suffix="%">0%</span></div>
          <div class="stat-label">Happy Clients</div>
        </div>
      </div>
    </div>

    <!-- Right: Image -->
    <div class="hero-editorial-image reveal-right">
      <div class="hero-image-wrapper">
        <img src="/images/hero_garden.png" alt="Beautiful Australian garden by TD Handy Man Australia" />
      </div>
    </div>

  </div>
</section>

<!-- ============================
     WHY CHOOSE US
     ============================ -->
<section class="section why-us" id="why-us">
  <div class="container">
    <div class="why-grid">
      <!-- Image Side -->
      <div class="why-image-wrap reveal-left">
        <!-- Leaf decoration -->
        <svg class="why-leaf-accent" width="120" height="120" viewBox="0 0 120 120" fill="none">
          <circle cx="60" cy="60" r="58" stroke="#2d6a4f" stroke-width="2" stroke-dasharray="8 6"/>
          <path d="M60 20 Q80 60 60 100 Q40 60 60 20Z" fill="#2d6a4f" opacity="0.3"/>
        </svg>

        <img src="/images/landscaping_feature.png" alt="Professional landscaping in Australia" class="why-img-main" />

        <div class="why-img-badge" aria-label="12 years of excellence">
          <div class="badge-num">12</div>
          <div class="badge-text">Years of<br/>Excellence</div>
        </div>
      </div>

      <!-- Content Side -->
      <div class="why-content reveal-right">
        <span class="section-label">Why Choose Us</span>
        <h2 class="section-title">Australia's Trusted<br /><em>Garden Specialists</em></h2>
        <p class="section-subtitle">
          We combine deep knowledge of Australian flora with professional craftsmanship to deliver garden and landscaping services that exceed expectations every time.
        </p>

        <div class="why-features">
          <div class="why-feature">
            <div class="feature-icon">🌿</div>
            <div class="feature-text">
              <h4>Native Plant Experts</h4>
              <p>Specialising in Australian native gardens that thrive year-round.</p>
            </div>
          </div>
          <div class="why-feature">
            <div class="feature-icon">⭐</div>
            <div class="feature-text">
              <h4>5-Star Rated</h4>
              <p>Consistently top-rated by our satisfied clients across Australia.</p>
            </div>
          </div>
          <div class="why-feature">
            <div class="feature-icon">🔧</div>
            <div class="feature-text">
              <h4>Fully Equipped</h4>
              <p>Professional-grade tools and equipment for every job.</p>
            </div>
          </div>
          <div class="why-feature">
            <div class="feature-icon">💧</div>
            <div class="feature-text">
              <h4>Water-Smart</h4>
              <p>Eco-friendly, drought-tolerant garden designs for Australia's climate.</p>
            </div>
          </div>
        </div>

        <a href="/about" class="btn btn-primary" id="why-us-learn-more" style="margin-top: 12px;">
          Learn More About Us
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
        </a>
      </div>
    </div>
  </div>
</section>

<!-- ============================
     SERVICES PREVIEW
     ============================ -->
<section class="section services-preview" id="services-preview">
  <div class="container">
    <div class="services-preview-header">
      <div>
        <span class="section-label">What We Do</span>
        <h2 class="section-title" style="color: white;">Our Core <em style="color: var(--green-pale);">Services</em></h2>
        <p class="section-subtitle">From routine lawn care to complete landscape transformations — we do it all.</p>
      </div>
      <a href="/services" class="btn btn-outline" id="view-all-services" style="color: white; border-color: rgba(255,255,255,0.4); flex-shrink: 0;">
        View All Services
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
      </a>
    </div>

    <div class="services-cards">
      <div class="service-card reveal">
        <img src="/images/lawn_mowing.png" alt="Lawn Mowing Service" class="service-card-img" />
        <div class="service-card-overlay">
          <span class="service-card-tag">Regular & One-Off</span>
          <h3 class="service-card-title">Lawn Mowing & Care</h3>
          <p class="service-card-desc">Professional lawn mowing, edging, and fertilisation to keep your lawn looking pristine all year round.</p>
          <a href="/services#lawn-care" class="service-card-arrow" id="service-lawn-link">
            Learn more
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
          </a>
        </div>
      </div>

      <div class="service-card reveal">
        <img src="/images/landscaping_feature.png" alt="Landscaping Design" class="service-card-img" />
        <div class="service-card-overlay">
          <span class="service-card-tag">Design & Build</span>
          <h3 class="service-card-title">Landscaping Design</h3>
          <p class="service-card-desc">Complete landscape design and construction — from concept to completion for residential and commercial spaces.</p>
          <a href="/services#landscaping" class="service-card-arrow" id="service-landscaping-link">
            Learn more
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
          </a>
        </div>
      </div>

      <div class="service-card reveal">
        <img src="/images/garden_maintenance.png" alt="Garden Maintenance" class="service-card-img" />
        <div class="service-card-overlay">
          <span class="service-card-tag">Ongoing Care</span>
          <h3 class="service-card-title">Garden Maintenance</h3>
          <p class="service-card-desc">Regular pruning, weeding, mulching and plant care to keep your garden healthy and looking beautiful.</p>
          <a href="/services#garden-maintenance" class="service-card-arrow" id="service-maintenance-link">
            Learn more
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

