<%- include('partials/header', { page: 'home', title: title, description: description }) %>

<!-- ─── HERO SECTION ─────────────────────────────────────────────────────── -->
<section class="hero-split" id="hero-section">
  <div class="hero-split-bg">
    <img src="/images/hero_handyman.png" alt="Premium Property Maintenance" />
  </div>
  <div class="hero-split-overlay"></div>
  
  <div class="container hero-content reveal">
    <span class="eyebrow">Premium Property Maintenance</span>
    <h1 class="hero-title-large">
      <span>Crafting</span>
      <em>Exceptional</em>
      <span>Spaces</span>
    </h1>
    <p class="hero-desc">
      We bring an architect's eye and a master craftsman's touch to property maintenance across South East Melbourne.
    </p>
    <div class="hero-actions">
      <a href="/portfolio" class="btn btn-primary">View Our Work</a>
      <a href="/contact" class="btn btn-outline">Request a Quote</a>
    </div>
  </div>
</section>

<!-- ─── PHILOSOPHY / INTRO ───────────────────────────────────────────────── -->
<section class="section features-luxury" id="intro-section">
  <div class="container">
    <div class="luxury-grid">
      <div class="luxury-text reveal">
        <span class="eyebrow">Our Philosophy</span>
        <h2 class="section-title">Melbourne's Trusted<br><em>Experts</em></h2>
        <p class="section-subtitle">
          We don't just maintain properties — we elevate them. By combining deep knowledge of landscaping, construction, and finishing trades, we deliver a flawless, high-end result that stands the test of time.
        </p>
        <br>
        <a href="/about" class="text-link">Discover Our Approach <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" style="margin-left: 8px;"><path d="M5 12h14M12 5l7 7-7 7"/></svg></a>
      </div>
      
      <div class="luxury-image-wrap reveal" style="transition-delay: 200ms;">
        <img src="/images/service_landscaping.png" alt="Premium Landscaping" />
      </div>
    </div>
  </div>
</section>

<!-- ─── SERVICES MASONRY ─────────────────────────────────────────────────── -->
<section class="section services-masonry" id="services-section">
  <div class="container">
    <div class="reveal">
      <span class="eyebrow">Our Expertise</span>
      <h2 class="section-title">Mastery in <em>Every Trade</em></h2>
    </div>
    
    <div class="masonry-grid">
      <a href="/services#landscaping" class="masonry-item reveal">
        <img src="/images/service_landscaping.png" alt="Landscaping" class="masonry-img">
        <div class="masonry-overlay">
          <span class="masonry-tag">01 / Outdoor</span>
          <h3 class="masonry-title">Landscaping</h3>
        </div>
      </a>
      
      <a href="/services#retaining-walls" class="masonry-item reveal" style="transition-delay: 150ms;">
        <img src="/images/service_retaining_walls.png" alt="Retaining Walls" class="masonry-img">
        <div class="masonry-overlay">
          <span class="masonry-tag">02 / Structural</span>
          <h3 class="masonry-title">Retaining Walls</h3>
        </div>
      </a>
      
      <a href="/services#rendering" class="masonry-item reveal" style="transition-delay: 300ms;">
        <img src="/images/service_rendering.png" alt="Rendering" class="masonry-img">
        <div class="masonry-overlay">
          <span class="masonry-tag">03 / Finishing</span>
          <h3 class="masonry-title">Rendering & Painting</h3>
        </div>
      </a>
    </div>
  </div>
</section>

<!-- ─── FULL SCREEN QUOTE ────────────────────────────────────────────────── -->
<section class="quote-section" id="statement-section">
  <div class="quote-bg">
    <img src="/images/service_tiling.png" alt="Tiling Excellence" />
  </div>
  <div class="container quote-content reveal">
    <h2 class="quote-text">
      "True craftsmanship is invisible. You don't see the work, you only feel the elegance of the result."
    </h2>
    <span class="quote-author">— TD HANDYMAN</span>
  </div>
</section>

<%- include('partials/footer') %>
