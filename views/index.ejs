<%- include('partials/header', { page: 'home', title: title, description: description }) %>

<!-- ─── HERO SECTION ─────────────────────────────────────────────────────── -->
<section class="page-hero" style="min-height: 100vh; height: auto; padding-top: 150px; padding-bottom: 100px; display: flex; align-items: center; text-align: left; position: relative;">
  <div class="page-hero-bg" style="position: absolute; inset: 0; overflow: hidden; z-index: 0;">
    <!-- 1. Architectural Image -->
    <img src="/images/hero_architecture.png" alt="Premium Property Maintenance Blueprint" style="filter: brightness(0.95) contrast(1.1); width: 100%; height: 100%; object-fit: cover; transition: var(--transition-slow);" />
    
    <!-- 2. Premium Adaptive Overlay (Dark/Light Mode) -->
    <div style="position: absolute; inset: 0; background: var(--hero-bg-gradient-1); transition: var(--transition-slow);"></div>
    <div style="position: absolute; inset: 0; background: var(--hero-bg-gradient-2); transition: var(--transition-slow);"></div>
    
    <!-- 3. Glowing Detail Orbs (Green & Blue) -->
    <div class="glow-orb orb-teal" style="width: 800px; height: 800px; top: -10%; left: -10%; opacity: 0.3; filter: blur(120px); position: absolute; background: rgba(15,138,126,0.6);"></div>
    <div class="glow-orb orb-blue" style="width: 600px; height: 600px; bottom: -20%; right: 0%; opacity: 0.2; filter: blur(120px); background: rgba(8,23,84,0.5); position: absolute;"></div>

    <!-- 4. Architectural Art / CAD Blueprint Elements -->
    <!-- Grid -->
    <div style="position: absolute; inset: 0; background-image: linear-gradient(rgba(8,23,84,0.04) 1px, transparent 1px), linear-gradient(90deg, rgba(8,23,84,0.04) 1px, transparent 1px); background-size: 50px 50px; mix-blend-mode: multiply;"></div>
    
    <!-- Crosshairs -->
    <div style="position: absolute; top: 15%; left: 8%; color: var(--accent); font-weight: 300; font-family: monospace; font-size: 20px; opacity: 0.5;">+</div>
    <div style="position: absolute; bottom: 25%; right: 12%; color: var(--accent); font-weight: 300; font-family: monospace; font-size: 20px; opacity: 0.5;">+</div>
    <div style="position: absolute; top: 35%; right: 8%; color: var(--accent-hover); font-weight: 300; font-family: monospace; font-size: 20px; opacity: 0.5;">+</div>
    <div style="position: absolute; bottom: 15%; left: 18%; color: var(--accent-hover); font-weight: 300; font-family: monospace; font-size: 20px; opacity: 0.5;">+</div>
    
    <!-- Measurement Scale Lines -->
    <div style="position: absolute; top: 50%; right: 0; width: 80px; height: 1px; background: rgba(8,23,84,0.15);"></div>
    <div style="position: absolute; top: 48%; right: 90px; font-family: monospace; font-size: 10px; color: rgba(8,23,84,0.35); transform: rotate(-90deg); transform-origin: right center; letter-spacing: 0.2em;">SCALE 1:100</div>
    <div style="position: absolute; bottom: 0; left: 35%; width: 1px; height: 80px; background: rgba(8,23,84,0.15);"></div>

    <!-- Realistic Garden Grass Overlay (Tall & Grounded) -->
    <div style="position: absolute; bottom: 0; left: 0; width: 100%; height: 50vh; min-height: 450px; background-image: url('/images/grass_overlay.png'); background-position: bottom center; background-repeat: repeat-x; background-size: auto 100%; mix-blend-mode: multiply; opacity: 0.85; z-index: 5; pointer-events: none; transition: var(--transition-slow); filter: contrast(1.1); transform: translateY(120px) scaleX(1.05); transform-origin: bottom center;"></div>
    
    <!-- Animated Mower Worker (Realistic & Large) -->
    <style>
      @keyframes mow-grass {
        0% { transform: translateX(-450px); }
        100% { transform: translateX(110vw); }
      }
    </style>
    <div style="position: absolute; bottom: 10%; left: 0; width: 400px; height: 300px; background-image: url('/images/mower_realistic.png'); background-size: contain; background-position: bottom center; background-repeat: no-repeat; mix-blend-mode: multiply; opacity: 0.9; z-index: 6; pointer-events: none; animation: mow-grass 25s linear infinite; filter: contrast(1.1);"></div>
  </div>
  
  <div class="container hero-content reveal" style="position: relative; z-index: 2; width: 100%;">
    
    <div style="display: flex; flex-wrap: wrap; gap: 60px; align-items: center; justify-content: space-between;">
      
      <!-- Left Side: Main Typography & Actions -->
      <div style="flex: 1 1 500px; max-width: 700px;">
        <!-- Premium Adaptive Glass Floating Badge -->
        <div style="display: inline-flex; align-items: center; gap: 10px; background: var(--glass-card-bg); backdrop-filter: blur(20px); padding: 8px 20px; border-radius: 0 15px 0 15px; border: 1px solid var(--glass-card-border); border-top: 1px solid var(--glass-card-highlight); margin-bottom: 24px; box-shadow: 0 10px 30px rgba(0,0,0,0.05); transition: var(--transition-slow);">
          <span style="display: flex; width: 10px; height: 10px; background: var(--accent); border-radius: 50%; animation: pulseAccent 2s infinite; box-shadow: 0 0 10px var(--accent);"></span>
          <span style="font-family: var(--font-body); font-size: 0.8rem; font-weight: 700; letter-spacing: 0.15em; text-transform: uppercase; color: var(--accent);">Melbourne's Premium Choice</span>
        </div>

        <h1 class="hero-title-large" style="margin-bottom: 20px; font-size: clamp(3rem, 5vw, 5rem); line-height: 1.05; word-break: keep-all;">
          <!-- Premium Adaptive Gradient Text (All on one line) -->
          <span style="background: var(--hero-text-gradient); -webkit-background-clip: text; -webkit-text-fill-color: transparent; transition: var(--transition-slow);">Crafting Exceptional Spaces</span>
        </h1>
        
        <p class="hero-desc" style="font-size: 1.2rem; margin-bottom: 40px; color: var(--text-secondary); max-width: 550px; line-height: 1.6; font-weight: 500;">
          We bring an architect's eye and a master craftsman's touch to property maintenance across South East Melbourne.
        </p>
        
        <div class="hero-actions" style="display: flex; gap: 20px; flex-wrap: wrap;">
          <!-- Primary Adaptive Transparent Glass Button -->
          <a href="/services" class="btn btn-primary" style="padding: 16px 36px; font-size: 1.1rem; background: var(--glass-card-bg); backdrop-filter: blur(20px); -webkit-backdrop-filter: blur(20px); border: 1px solid var(--glass-card-border); border-top: 1px solid var(--glass-card-highlight); color: var(--text-primary); box-shadow: 0 10px 30px rgba(0,0,0,0.1); transition: var(--transition-slow);">Explore Services</a>
          
          <!-- Secondary Adaptive Transparent Glass Button -->
          <a href="/contact" class="btn btn-outline" style="padding: 16px 36px; font-size: 1.1rem; background: transparent; backdrop-filter: blur(20px); -webkit-backdrop-filter: blur(20px); border: 1px solid var(--glass-card-border); border-top: 1px solid var(--glass-card-highlight); color: var(--text-primary); box-shadow: 0 10px 30px rgba(0,0,0,0.1); transition: var(--transition-slow);">Request Quote</a>
        </div>
      </div>

      <!-- Right Side: Ultra-Modern Light Glass Trust Cards -->
      <div style="flex: 1 1 300px; display: flex; flex-direction: column; gap: 24px;">
        
        <!-- Trust Card 1 (Adaptive Glass) -->
        <div style="background: var(--glass-card-bg); backdrop-filter: blur(40px); -webkit-backdrop-filter: blur(40px); border: 1px solid var(--glass-card-border); border-top: 1px solid var(--glass-card-highlight); padding: 30px; border-radius: 0; clip-path: polygon(30px 0, 100% 0, 100% calc(100% - 30px), calc(100% - 30px) 100%, 0 100%, 0 30px); display: flex; align-items: center; gap: 20px; transform: translateX(min(0px, -2vw)); box-shadow: 0 30px 60px rgba(0,0,0,0.1);">
          <div style="width: 60px; height: 60px; border-radius: 0 15px 0 15px; background: linear-gradient(135deg, #1E56A0, var(--accent)); display: flex; align-items: center; justify-content: center; color: white; box-shadow: 0 10px 20px rgba(8,23,84,0.2); border: 1px solid var(--glass-card-highlight); flex-shrink: 0;">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
          </div>
          <div>
            <div style="font-family: var(--font-heading); font-weight: 700; font-size: 1.8rem; color: var(--text-primary); line-height: 1;">10+ Years</div>
            <div style="font-size: 0.85rem; color: var(--accent); text-transform: uppercase; letter-spacing: 0.1em; margin-top: 4px; font-weight: 600;">Master Experience</div>
          </div>
        </div>
        
        <!-- Trust Card 2 (Adaptive Glass) -->
        <div style="background: var(--glass-card-bg); backdrop-filter: blur(40px); -webkit-backdrop-filter: blur(40px); border: 1px solid var(--glass-card-border); border-top: 1px solid var(--glass-card-highlight); padding: 30px; border-radius: 0; clip-path: polygon(0 30px, 30px 0, 100% 0, 100% calc(100% - 30px), calc(100% - 30px) 100%, 0 100%); display: flex; align-items: center; gap: 20px; transform: translateX(max(0px, 2vw)); box-shadow: 0 30px 60px rgba(0,0,0,0.1);">
          <div style="width: 60px; height: 60px; border-radius: 0 15px 0 15px; background: var(--bg-primary); border: 1px solid var(--glass-card-border); display: flex; align-items: center; justify-content: center; color: var(--accent-hover); flex-shrink: 0;">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
          </div>
          <div>
            <div style="font-family: var(--font-heading); font-weight: 700; font-size: 1.8rem; color: var(--text-primary); line-height: 1;">5-Star Rated</div>
            <div style="font-size: 0.85rem; color: var(--accent); text-transform: uppercase; letter-spacing: 0.1em; margin-top: 4px; font-weight: 600;">Client Satisfaction</div>
          </div>
        </div>

      </div>
    </div>
  </div>
  
  <div style="position: absolute; right: 40px; bottom: 40px; display: flex; flex-direction: column; align-items: center; gap: 10px; z-index: 2;">
    <span style="writing-mode: vertical-rl; font-family: var(--font-body); font-size: 0.7rem; letter-spacing: 0.3em; text-transform: uppercase; color: rgba(255,255,255,0.5);">Scroll</span>
    <div style="width: 1px; height: 60px; background: linear-gradient(to bottom, rgba(255,255,255,0.5), transparent);"></div>
  </div>
</section>

<!-- ─── PHILOSOPHY / INTRO ───────────────────────────────────────────────── -->
<section class="section features-luxury" id="intro-section">
  <!-- Glowing Orbs -->
  <div class="glow-orb orb-teal" style="width: 400px; height: 400px; top: 0; left: -100px;"></div>
  <div class="glow-orb orb-blue" style="width: 300px; height: 300px; bottom: -50px; right: -50px; animation-delay: -5s;"></div>

  <div class="container">
    <div class="luxury-grid">
      <div class="luxury-text reveal">
        <span class="eyebrow">Our Philosophy</span>
        <h2 class="section-title">Melbourne's Trusted<br><em>Experts</em></h2>
        <p class="section-subtitle">
          We don't just maintain properties — we elevate them. By combining deep knowledge of landscaping, construction, and finishing trades, we deliver a flawless, high-end result that stands the test of time.
        </p>
        <br>
        <a href="/about" class="text-link">Discover Our Approach <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" style="margin-left: 8px;"><path d="M5 12h14M12 5l7 7-7 7"/></svg></a>
      </div>
      
      <div class="luxury-image-wrap reveal" style="transition-delay: 200ms;">
        <img src="/images/service_landscaping.png" alt="Premium Landscaping" />
      </div>
    </div>
  </div>
</section>

<!-- ─── WHAT WE DO ───────────────────────────────────────────────────────── -->
<section class="section" id="what-we-do" style="background: var(--bg-secondary); border-top: 1px solid var(--border-light); border-bottom: 1px solid var(--border-light);">
  <div class="container">
    <div class="text-center reveal" style="margin-bottom: 60px;">
      <span class="eyebrow">Our Expertise</span>
      <h2 class="section-title">What We <em>Do</em></h2>
      <p class="section-subtitle" style="margin: 0 auto;">Comprehensive property maintenance and enhancement solutions, delivered with meticulous attention to detail.</p>
    </div>

    <div class="services-grid-8">
      <% const allServices = [
        { name: 'Landscaping', desc: 'Custom garden designs, planting, and complete outdoor transformations.', img: '/images/service_landscaping_action.png', icon: 'M12 2L2 22h20L12 2z' },
        { name: 'Retaining Walls', desc: 'Structurally sound and aesthetically pleasing walls for any terrain.', img: '/images/service_retaining_walls_action.png', icon: 'M4 4h16v16H4z' },
        { name: 'Rendering', desc: 'Premium exterior and interior cement or acrylic rendering finishes.', img: '/images/service_rendering_action.png', icon: 'M3 12h18M3 6h18M3 18h18' },
        { name: 'Tiling', desc: 'Precision wall and floor tiling for bathrooms, kitchens, and outdoor spaces.', img: '/images/service_tiling_action.png', icon: 'M4 4h7v7H4zM13 4h7v7h-7zM4 13h7v7H4zM13 13h7v7h-7z' },
        { name: 'General Maintenance', desc: 'Reliable, ongoing property upkeep and routine repair services.', img: '/images/service_maintenance_action.png', icon: 'M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 9.36l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 9.36-7.94l-3.77 3.77a1 1 0 0 0 0 1.41z' },
        { name: 'Painting', desc: 'Flawless interior and exterior painting with premium quality paints.', img: '/images/service_painting_action.png', icon: 'M12 2c-5.52 0-10 4.48-10 10s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm0 18c-4.41 0-8-3.59-8-8s3.59-8 8-8 8 3.59 8 8-3.59 8-8 8zm-1-13h2v6h-2zm0 8h2v2h-2z' },
        { name: 'Irrigation Systems', desc: 'Automated watering solutions to keep your landscapes lush and green.', img: '/images/service_irrigation_action.png', icon: 'M12 2.69l5.66 5.66a8 8 0 1 1-11.31 0z' },
        { name: 'Modern Wall Moulding', desc: 'Elegant architectural wainscoting and modern wall paneling.', img: '/images/service_moulding_action.png', icon: 'M4 4h16v16H4z M8 8h8v8H8z' }
      ] %>
      
      <% allServices.forEach((s, i) => { %>
        <div class="service-image-card reveal" style="transition-delay: <%= i * 50 %>ms;">
          <div class="sic-bg">
            <img src="<%= s.img %>" alt="<%= s.name %>" loading="lazy">
          </div>
          <div class="sic-content">
            <div class="sic-icon">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="<%= s.icon %>" />
              </svg>
            </div>
            <h3 class="sic-title"><%= s.name %></h3>
            <p class="sic-desc"><%= s.desc %></p>
            <a href="/services" class="sic-link">Learn More <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg></a>
          </div>
        </div>
      <% }) %>
    </div>
  </div>
</section>


<!-- ─── RECENT PROJECTS (GALLERY PREVIEW) ─────────────────────────────────── -->
<section class="section" style="position: relative;">
  <div class="glow-orb orb-teal" style="width: 500px; height: 500px; top: -100px; right: -100px;"></div>
  
  <div class="container">
    <div class="text-center reveal" style="margin-bottom: 60px;">
      <span class="eyebrow">Portfolio</span>
      <h2 class="section-title">Recent <em>Transformations</em></h2>
    </div>

    <div class="gallery-masonry">
      <!-- Item 1 -->
      <a href="/gallery" class="gallery-item reveal">
        <img src="/images/service_landscaping_action.png" alt="Landscape Design" loading="lazy" />
        <div class="gallery-overlay">
          <h4>Premium Landscaping</h4>
          <span>Outdoor Living</span>
        </div>
      </a>
      <!-- Item 2 -->
      <a href="/gallery" class="gallery-item reveal" style="transition-delay: 100ms;">
        <img src="/images/service_rendering_action.png" alt="House Rendering" loading="lazy" />
        <div class="gallery-overlay">
          <h4>Facade Rendering</h4>
          <span>Finishing Touch</span>
        </div>
      </a>
      <!-- Item 3 -->
      <a href="/gallery" class="gallery-item reveal" style="transition-delay: 200ms;">
        <img src="/images/service_tiling_action.png" alt="Tiling" loading="lazy" />
        <div class="gallery-overlay">
          <h4>Precision Tiling</h4>
          <span>Interior & Exterior</span>
        </div>
      </a>
    </div>

    <div class="text-center reveal" style="margin-top: 50px;">
      <a href="/gallery" class="btn btn-outline">View Full Gallery</a>
    </div>
  </div>
</section>

<!-- ─── TESTIMONIALS & CTA (CINEMATIC) ────────────────────────────────────── -->
<section class="section" style="padding: 0; position: relative;">
  
  <div style="position: absolute; inset: 0; z-index: 0;">
    <img src="/images/service_painting_action.png" alt="Testimonials Background" style="width: 100%; height: 100%; object-fit: cover; filter: grayscale(10%);" />
    <div style="position: absolute; inset: 0; background: linear-gradient(to bottom, rgba(3,10,13,0.98) 0%, rgba(3,10,13,0.8) 50%, rgba(15,138,126,0.3) 100%);"></div>
  </div>

  <div class="container" style="position: relative; z-index: 1; padding: 100px 4vw;">
    
    <div class="text-center reveal" style="margin-bottom: 60px;">
      <span class="eyebrow" style="color: #fff; opacity: 0.8;">Client Feedback</span>
      <h2 class="section-title" style="color: #fff;">Words of <em style="color: #fff; background: none; -webkit-text-fill-color: #fff;">Trust</em></h2>
    </div>

    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 30px; margin-bottom: 100px;">
      <!-- Testimonial 1 -->
      <div class="reveal" style="background: rgba(3, 10, 13, 0.6); backdrop-filter: blur(20px); border: 1px solid rgba(255,255,255,0.1); padding: 40px; border-radius: var(--radius-lg); box-shadow: 0 20px 40px rgba(0,0,0,0.3);">
        <div style="color: var(--accent); margin-bottom: 20px;">
          <svg width="30" height="30" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
        </div>
        <p style="font-size: 1.1rem; line-height: 1.8; color: #fff; margin-bottom: 24px; font-style: italic;">"The level of craftsmanship is unmatched. They transformed our entire backyard and retained all the sloping earth perfectly."</p>
        <div style="font-family: var(--font-heading); color: var(--accent); letter-spacing: 0.1em; text-transform: uppercase;">— Michael R.</div>
      </div>
      
      <!-- Testimonial 2 -->
      <div class="reveal" style="transition-delay: 100ms; background: rgba(3, 10, 13, 0.6); backdrop-filter: blur(20px); border: 1px solid rgba(255,255,255,0.1); padding: 40px; border-radius: var(--radius-lg); box-shadow: 0 20px 40px rgba(0,0,0,0.3);">
        <div style="color: var(--accent); margin-bottom: 20px;">
          <svg width="30" height="30" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
        </div>
        <p style="font-size: 1.1rem; line-height: 1.8; color: #fff; margin-bottom: 24px; font-style: italic;">"Professional, reliable, and incredibly detail-oriented. The rendering and painting work completely modernized our home's facade."</p>
        <div style="font-family: var(--font-heading); color: var(--accent); letter-spacing: 0.1em; text-transform: uppercase;">— Sarah & James</div>
      </div>
    </div>

    <!-- Glowing CTA Panel -->
    <div class="reveal" style="position: relative; background: linear-gradient(135deg, rgba(15,138,126,0.9), rgba(15,138,126,0.4)); backdrop-filter: blur(20px); border: 1px solid rgba(255,255,255,0.2); border-radius: var(--radius-lg); padding: 60px 40px; text-align: center; box-shadow: 0 30px 60px rgba(15,138,126,0.2); overflow: hidden;">
      <div style="position: absolute; top: 0; left: 0; width: 100%; height: 100%; background: radial-gradient(circle at top right, rgba(255,255,255,0.2), transparent); pointer-events: none;"></div>
      
      <h2 style="font-family: var(--font-heading); font-size: 3rem; color: #fff; margin-bottom: 16px;">Ready to Elevate Your Property?</h2>
      <p style="color: rgba(255,255,255,0.9); font-size: 1.2rem; margin-bottom: 32px; max-width: 600px; margin-left: auto; margin-right: auto;">Contact our expert team today for a comprehensive consultation and transparent quote.</p>
      
      <a href="/contact" class="btn btn-white" style="padding: 18px 40px; font-size: 1.1rem;">Get a Free Quote</a>
    </div>

  </div>
</section>

<%- include('partials/footer') %>
