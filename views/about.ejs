<%- include('partials/header') %>
<script>document.body.classList.add('light-nav');</script>

<!-- Page Hero -->
<section class="page-hero" id="about-hero">
  <div class="container page-hero-inner">
    <span class="section-label">Our Story</span>
    <h1 class="page-title">Proudly <em style="font-style:italic; color: var(--green-pale);">Australian</em></h1>
    <p class="page-description">A local team with deep roots in Australian gardening and landscaping — passionate about transforming outdoor spaces across the country.</p>
  </div>
</section>

<!-- About Story -->
<section class="section about-story" id="about-story">
  <div class="container">
    <div class="about-story-grid">

      <div class="about-img-stack reveal-left">
        <img src="/images/hero_garden.png" alt="TD Handy Man Australia team at work" class="about-img-main" />
        <img src="/images/about_team.png" alt="Our team of gardening professionals" class="about-img-accent" />
        <div class="about-experience-badge">
          <div class="num">12</div>
          <div class="label">Years in<br />Business</div>
        </div>
      </div>

      <div class="about-content reveal-right">
        <span class="section-label">About Us</span>
        <h2 class="section-title">Grown From a<br /><em>Love of the Land</em></h2>

        <p class="section-subtitle" style="max-width: 100%; margin-bottom: 24px;">
          TD Handy Man Australia was founded with a simple belief: every Australian home deserves a beautiful outdoor space. What started as a one-man operation has grown into a trusted team of passionate gardeners and landscapers serving clients across the country.
        </p>
        <p class="section-subtitle" style="max-width: 100%; margin-bottom: 24px;">
          We have a deep respect for Australia's unique flora and fauna, which shapes everything we do — from plant selection to water management. Whether you have a small suburban courtyard or a sprawling rural property, we bring the same care and expertise to every job.
        </p>
        <p class="section-subtitle" style="max-width: 100%; margin-bottom: 40px;">
          We're fully licensed and insured, and we take pride in our transparent pricing, reliable scheduling, and the quality of our workmanship. Your satisfaction is our guarantee.
        </p>

        <div style="display: flex; gap: 20px; flex-wrap: wrap;">
          <a href="/contact" class="btn btn-primary" id="about-get-quote">Get a Free Quote</a>
          <a href="/services" class="btn btn-outline" id="about-our-services">Our Services</a>
        </div>
      </div>

    </div>
  </div>
</section>

<!-- Values -->
<section class="section about-values" id="our-values">
  <div class="container">
    <div style="text-align: center;">
      <span class="section-label">Our Values</span>
      <h2 class="section-title" style="margin: 0 auto 16px;">What We Stand For</h2>
      <p class="section-subtitle" style="margin: 0 auto;">The principles that guide every project we take on.</p>
    </div>

    <div class="values-grid">
      <div class="value-card reveal">
        <div class="value-icon">🌿</div>
        <h3>Environmental Respect</h3>
        <p>We prioritise sustainable practices, native plants, and water-wise designs that protect Australia's precious ecosystems.</p>
      </div>
      <div class="value-card reveal">
        <div class="value-icon">⭐</div>
        <h3>Excellence in Craft</h3>
        <p>We hold ourselves to the highest standard in every job — from the smallest trim to a full landscape transformation.</p>
      </div>
      <div class="value-card reveal">
        <div class="value-icon">🤝</div>
        <h3>Honest Partnerships</h3>
        <p>Transparent quotes, clear communication, and reliable service. No surprises — just trustworthy, professional work.</p>
      </div>
      <div class="value-card reveal">
        <div class="value-icon">🇦🇺</div>
        <h3>Community Pride</h3>
        <p>We're local. We understand Australian gardens, lifestyles, and what it means to create a beautiful outdoor home.</p>
      </div>
    </div>
  </div>
</section>

<!-- Team Section -->
<section class="section" id="our-team" style="background: var(--warm-white);">
  <div class="container">
    <div style="display: grid; grid-template-columns: 1.2fr 1fr; gap: 72px; align-items: center;">

      <div class="reveal-left">
        <span class="section-label">Our Team</span>
        <h2 class="section-title">People Who<br /><em>Love What They Do</em></h2>
        <p class="section-subtitle" style="max-width: 100%; margin-bottom: 24px;">
          Our team is made up of qualified horticulturalists, landscape designers, and dedicated tradespeople who genuinely love working outdoors and helping clients create their dream garden.
        </p>
        <p class="section-subtitle" style="max-width: 100%; margin-bottom: 36px;">
          Every member of our team undergoes continuous training and holds the relevant certifications for their area of expertise. When we arrive at your property, you can trust that you're getting the best people for the job.
        </p>

        <div style="display: flex; gap: 48px;">
          <div>
            <div style="font-family: var(--font-heading); font-size: 2.5rem; font-weight: 800; color: var(--green-mid);" data-count="15" data-suffix="+">0+</div>
            <div style="font-size: 0.82rem; color: var(--text-light); font-weight: 500; text-transform: uppercase; letter-spacing: 0.08em;">Team Members</div>
          </div>
          <div>
            <div style="font-family: var(--font-heading); font-size: 2.5rem; font-weight: 800; color: var(--green-mid);" data-count="500" data-suffix="+">0+</div>
            <div style="font-size: 0.82rem; color: var(--text-light); font-weight: 500; text-transform: uppercase; letter-spacing: 0.08em;">Happy Clients</div>
          </div>
          <div>
            <div style="font-family: var(--font-heading); font-size: 2.5rem; font-weight: 800; color: var(--green-mid);" data-count="8">0</div>
            <div style="font-size: 0.82rem; color: var(--text-light); font-weight: 500; text-transform: uppercase; letter-spacing: 0.08em;">States Served</div>
          </div>
        </div>
      </div>

      <div class="reveal-right">
        <div style="border-radius: var(--radius-lg); overflow: hidden; box-shadow: var(--shadow-xl); height: 480px;">
          <img src="/images/about_team.png" alt="TD Handy Man Australia team" style="width: 100%; height: 100%; object-fit: cover;" />
        </div>
      </div>

    </div>
  </div>
</section>

<!-- CTA -->
<section class="cta-banner" id="about-cta">
  <div class="container">
    <div class="cta-content">
      <div class="cta-text reveal-left">
        <h2>Let's Work Together<br />on Your Garden</h2>
        <p>Get in touch today and let's discuss how we can transform your outdoor space into something truly special.</p>
      </div>
      <div class="cta-actions reveal-right">
        <a href="/contact" class="btn btn-white" id="about-cta-contact">Contact Us</a>
        <a href="/gallery" class="btn btn-outline" id="about-cta-gallery" style="color: white; border-color: rgba(255,255,255,0.5);">View Our Work</a>
      </div>
    </div>
  </div>
</section>

<%- include('partials/footer') %>
