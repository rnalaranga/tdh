<%- include('partials/header', { page: 'about', title: 'Our Story — TD HANDYMAN', description: 'About TD HANDYMAN and our property maintenance experts.' }) %>

<!-- ─── PAGE HERO ────────────────────────────────────────────────────────── -->
<section class="page-hero">
  <div class="page-hero-bg">
    <img src="/images/about_team_new.png" alt="TD HANDYMAN Team" />
  </div>
  <div class="container page-hero-content reveal">
    <span class="eyebrow">Our Story</span>
    <h1 class="section-title">Built on <em>Excellence</em></h1>
  </div>
</section>

<!-- ─── ABOUT STORY ──────────────────────────────────────────────────────── -->
<section class="section">
  <div class="container">
    <div class="about-grid">
      <div class="reveal">
        <h2 class="section-title">Over a Decade of<br><em>Craftsmanship</em></h2>
        <p style="color: var(--text-secondary); font-size: 1.1rem; line-height: 1.8; margin-bottom: 24px;">
          TD HANDYMAN was founded with a singular vision: to bring exceptional quality and unparalleled reliability to property maintenance in South East Melbourne. 
        </p>
        <p style="color: var(--text-secondary); font-size: 1.1rem; line-height: 1.8;">
          What started as a small local trade business has grown into a comprehensive property services firm. We specialize in the difficult trades—retaining walls, rendering, and high-end landscaping—while maintaining the same personal touch and meticulous attention to detail that our very first clients experienced.
        </p>
        
        <div style="margin-top: 40px; border-top: 1px solid var(--border-light); padding-top: 24px;">
          <span style="font-family: var(--font-heading); font-size: 1.5rem; display: block; margin-bottom: 4px;">TD HANDYMAN</span>
          <span style="font-family: var(--font-body); font-size: 0.7rem; letter-spacing: 0.2em; text-transform: uppercase; color: var(--accent-gold);">Founders & Master Craftsmen</span>
        </div>
      </div>
      
      <div class="reveal" style="position: relative; padding: 40px;">
        <!-- Image with Border Frame -->
        <div style="position: absolute; top: 0; left: 0; width: 60%; height: 60%; border-top: 1px solid var(--accent-gold); border-left: 1px solid var(--accent-gold);"></div>
        <div style="position: absolute; bottom: 0; right: 0; width: 60%; height: 60%; border-bottom: 1px solid var(--accent-gold); border-right: 1px solid var(--accent-gold);"></div>
        <img src="/images/about_team_new.png" alt="Team at work" style="width: 100%; aspect-ratio: 4/5; object-fit: cover; filter: grayscale(20%); position: relative; z-index: 1;" />
      </div>
    </div>
  </div>
</section>

<!-- ─── STATS SECTION ────────────────────────────────────────────────────── -->
<section class="section section-bg-alt">
  <div class="container">
    <div class="about-stats reveal">
      <div style="text-align: center;">
        <div class="stat-num">10+</div>
        <div class="stat-label">Years of Experience</div>
      </div>
      <div style="text-align: center;">
        <div class="stat-num">1000+</div>
        <div class="stat-label">Projects Completed</div>
      </div>
    </div>
  </div>
</section>

<!-- ─── OUR VALUES ───────────────────────────────────────────────────────── -->
<section class="section">
  <div class="container">
    <div class="text-center reveal">
      <span class="eyebrow">Our Principles</span>
      <h2 class="section-title">The TD HANDYMAN <em>Difference</em></h2>
    </div>
    
    <div class="values-grid">
      <!-- Value 1 -->
      <div class="value-card reveal">
        <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
        <h3 style="font-family: var(--font-heading); font-size: 1.5rem; margin-bottom: 12px;">Premium Quality</h3>
        <p style="color: var(--text-secondary); font-size: 0.9rem;">We never compromise on materials or technique. Every project is executed to the highest standard.</p>
      </div>
      
      <!-- Value 2 -->
      <div class="value-card reveal" style="transition-delay: 100ms;">
        <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
        <h3 style="font-family: var(--font-heading); font-size: 1.5rem; margin-bottom: 12px;">Reliability</h3>
        <p style="color: var(--text-secondary); font-size: 0.9rem;">We show up when we say we will, complete the job on schedule, and communicate transparently throughout.</p>
      </div>

      <!-- Value 3 -->
      <div class="value-card reveal" style="transition-delay: 200ms;">
        <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
        <h3 style="font-family: var(--font-heading); font-size: 1.5rem; margin-bottom: 12px;">Fully Insured</h3>
        <p style="color: var(--text-secondary); font-size: 0.9rem;">Total peace of mind. We are fully licensed, insured, and compliant with all Australian building standards.</p>
      </div>

      <!-- Value 4 -->
      <div class="value-card reveal" style="transition-delay: 300ms;">
        <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
        <h3 style="font-family: var(--font-heading); font-size: 1.5rem; margin-bottom: 12px;">Expert Team</h3>
        <p style="color: var(--text-secondary); font-size: 0.9rem;">Our crew consists of experienced, respectful professionals who treat your property with the utmost care.</p>
      </div>
    </div>
  </div>
</section>

<%- include('partials/footer') %>
