<%- include('partials/header', { page: 'gallery', title: 'Project Gallery — TD HANDYMAN', description: 'View our recent property transformations across South East Melbourne.' }) %>

<!-- ─── PAGE HERO ────────────────────────────────────────────────────────── -->
<section class="page-hero">
  <div class="page-hero-bg">
    <img src="/images/service_rendering.png" alt="TD HANDYMAN Recent Projects" />
  </div>
  <div class="container page-hero-content reveal">
    <span class="eyebrow">Our Work</span>
    <h1 class="section-title">Project <em>Gallery</em></h1>
  </div>
</section>

<!-- ─── GALLERY SECTION ──────────────────────────────────────────────────── -->
<section class="section" style="padding-top: 0;">
  <div class="container">
    
    <!-- Filter Buttons -->
    <div class="gallery-filters reveal">
      <button class="filter-btn active" data-filter="all">All Projects</button>
      <button class="filter-btn" data-filter="landscaping">Landscaping</button>
      <button class="filter-btn" data-filter="retaining-walls">Retaining Walls</button>
      <button class="filter-btn" data-filter="rendering">Rendering</button>
      <button class="filter-btn" data-filter="tiling">Tiling</button>
    </div>

    <!-- Gallery Grid (Masonry Style) -->
    <div class="gallery-masonry" id="lightgallery">
      
      <!-- Item 1 -->
      <a href="/images/service_landscaping_action.png" class="gallery-item reveal landscaping">
        <img src="/images/service_landscaping_action.png" alt="Landscape Transformation" loading="lazy" />
        <div class="gallery-overlay">
          <h4>Landscaping</h4>
          <span>Outdoor Living</span>
        </div>
      </a>

      <!-- Item 2 -->
      <a href="/images/service_retaining_walls_action.png" class="gallery-item reveal retaining-walls" style="transition-delay: 100ms;">
        <img src="/images/service_retaining_walls_action.png" alt="Retaining Wall Construction" loading="lazy" />
        <div class="gallery-overlay">
          <h4>Retaining Walls</h4>
          <span>Structural Integrity</span>
        </div>
      </a>

      <!-- Item 3 -->
      <a href="/images/service_rendering_action.png" class="gallery-item reveal rendering" style="transition-delay: 200ms;">
        <img src="/images/service_rendering_action.png" alt="Exterior House Rendering" loading="lazy" />
        <div class="gallery-overlay">
          <h4>Rendering</h4>
          <span>Finishing Touch</span>
        </div>
      </a>

      <!-- Item 4 -->
      <a href="/images/service_tiling_action.png" class="gallery-item reveal tiling">
        <img src="/images/service_tiling_action.png" alt="Outdoor Patio Tiling" loading="lazy" />
        <div class="gallery-overlay">
          <h4>Tiling</h4>
          <span>Precision Craft</span>
        </div>
      </a>

      <!-- Item 5 -->
      <a href="/images/service_painting_action.png" class="gallery-item reveal rendering" style="transition-delay: 100ms;">
        <img src="/images/service_painting_action.png" alt="Interior Painting Project" loading="lazy" />
        <div class="gallery-overlay">
          <h4>Painting</h4>
          <span>Flawless Color</span>
        </div>
      </a>

      <!-- Item 6 -->
      <a href="/images/service_moulding_action.png" class="gallery-item reveal tiling" style="transition-delay: 200ms;">
        <img src="/images/service_moulding_action.png" alt="Modern Wall Moulding" loading="lazy" />
        <div class="gallery-overlay">
          <h4>Wall Moulding</h4>
          <span>Elegant Accents</span>
        </div>
      </a>

    </div>
  </div>
</section>

<!-- Simple Gallery Filtering Script -->
<script>
  document.addEventListener('DOMContentLoaded', () => {
    const filterBtns = document.querySelectorAll('.filter-btn');
    const items = document.querySelectorAll('.gallery-item');

    filterBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        filterBtns.forEach(b => b.classList.remove('active'));
        btn.classList.add('active');

        const filterValue = btn.getAttribute('data-filter');

        items.forEach(item => {
          if (filterValue === 'all' || item.classList.contains(filterValue)) {
            item.style.display = 'block';
            setTimeout(() => { item.style.opacity = '1'; item.style.transform = 'scale(1)'; }, 50);
          } else {
            item.style.opacity = '0';
            item.style.transform = 'scale(0.95)';
            setTimeout(() => { item.style.display = 'none'; }, 400);
          }
        });
      });
    });
  });
</script>

