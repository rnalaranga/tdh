<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content="<%= description %>" />
  <!-- Theme Color for Mobile Browsers -->
  <meta name="theme-color" content="#0a1628" />
  <title><%= title %></title>

  <!-- Google Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;0,700;1,300;1,400;1,500&family=Plus+Jakarta+Sans:ital,wght@0,300;0,400;0,500;0,600;0,700;1,400&display=swap" rel="stylesheet" />

  <!-- Main CSS -->
  <link rel="stylesheet" href="/css/style.css" />

  <!-- Favicon -->
  <link rel="icon" type="image/png" href="/images/logo.png" />
  <!-- Inline script to prevent FOUC on theme load -->
  <script>
    (function() {
      const savedTheme = localStorage.getItem('theme');
      // Respect system preference if no saved theme
      let activeTheme = window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
      if (savedTheme) {
        activeTheme = savedTheme;
      }
      document.documentElement.setAttribute('data-theme', activeTheme);
      
      const metaThemeColor = document.querySelector('meta[name="theme-color"]');
      if (metaThemeColor) {
        // Use Navy Blue (#081754) for light mode, dark (#030a0d) for dark mode
        metaThemeColor.setAttribute('content', activeTheme === 'light' ? '#081754' : '#030a0d');
      }
    })();
  </script>
</head>
<body>

<!-- Navigation -->
<nav class="navbar" id="navbar">
  <div class="nav-container">
    <!-- Logo -->
    <a href="/" class="nav-logo" id="nav-logo" style="display: flex; align-items: center; gap: 15px; text-decoration: none;">
      <img src="/images/logo.png" alt="TD Handyman Logo" style="height: 50px; width: auto; display: block;" />
      <div class="mobile-hide-logo-text" style="display: flex; flex-direction: column; justify-content: center;">
        <span style="font-family: var(--font-heading); font-size: 1.4rem; font-weight: 700; color: var(--accent); letter-spacing: 0.05em; line-height: 1.1;">TD HANDYMAN</span>
      </div>
    </a>

    <!-- Nav Links -->
    <ul class="nav-links" id="nav-links">
      <li><a href="/" class="nav-link <%= page === 'home' ? 'active' : '' %>" id="nav-home">Home</a></li>
      <li><a href="/services" class="nav-link <%= page === 'services' ? 'active' : '' %>" id="nav-services">Services</a></li>
      <li><a href="/gallery" class="nav-link <%= page === 'gallery' ? 'active' : '' %>" id="nav-gallery">Gallery</a></li>
      <li><a href="/about" class="nav-link <%= page === 'about' ? 'active' : '' %>" id="nav-about">About</a></li>
      <li><a href="/contact" class="nav-link nav-cta <%= page === 'contact' ? 'active' : '' %>" id="nav-contact">Get a Quote</a></li>
    </ul>

    <!-- Actions: Theme & Hamburger -->
    <div style="display: flex; align-items: center; gap: 20px; position: relative;">
      <!-- Theme Toggle -->
      <button id="theme-toggle" class="theme-toggle" aria-label="Toggle theme">
        <!-- Sun icon (shown in dark theme) -->
        <svg class="sun-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="5"></circle><line x1="12" y1="1" x2="12" y2="3"></line><line x1="12" y1="21" x2="12" y2="23"></line><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line><line x1="1" y1="12" x2="3" y2="12"></line><line x1="21" y1="12" x2="23" y2="12"></line><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line></svg>
        <!-- Moon icon (shown in light theme) -->
        <svg class="moon-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path></svg>
      </button>

      <!-- Friendly Theme Popup Message -->
      <div id="theme-tooltip" style="position: absolute; top: 55px; right: 40px; background: var(--accent); color: #fff; padding: 12px 16px; border-radius: 8px; font-size: 0.85rem; width: 220px; text-align: center; box-shadow: 0 10px 30px rgba(0,0,0,0.2); z-index: 1002; opacity: 0; transform: translateY(-10px); transition: all 0.4s cubic-bezier(0.25, 1, 0.5, 1); pointer-events: none;">
        Hi! 👋 You can switch between Dark & Light modes here!
        <div style="position: absolute; top: -5px; right: 28px; width: 12px; height: 12px; background: var(--accent); transform: rotate(45deg);"></div>
      </div>

      <!-- Hamburger -->
      <button class="hamburger" id="hamburger" aria-label="Toggle menu" aria-expanded="false">
        <span></span><span></span><span></span>
      </button>
    </div>
  </div>
</nav>
