<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content="<%= description %>" />
  <!-- Theme Color for Mobile Browsers -->
  <meta name="theme-color" content="#0d1f17" />
  <title><%= title %></title>

  <!-- Google Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,600;0,700;0,800;1,400;1,600&family=Lora:ital,wght@0,400;0,500;0,600;0,700;1,400;1,500;1,600&display=swap" rel="stylesheet" />

  <!-- Main CSS -->
  <link rel="stylesheet" href="/css/style.css" />

  <!-- Favicon -->
  <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>🌿</text></svg>" />
</head>
<body>

<!-- Navigation -->
<nav class="navbar" id="navbar">
  <div class="nav-container">
    <!-- Logo -->
    <a href="/" class="nav-logo" id="nav-logo">
      <div class="logo-icon">
        <svg width="36" height="36" viewBox="0 0 36 36" fill="none" xmlns="http://www.w3.org/2000/svg">
          <circle cx="18" cy="18" r="18" fill="#2d6a4f"/>
          <path d="M18 8 Q22 14 18 18 Q14 14 18 8Z" fill="#52b788"/>
          <path d="M18 12 Q25 16 22 22 Q16 20 18 12Z" fill="#74c69d"/>
          <path d="M18 12 Q11 16 14 22 Q20 20 18 12Z" fill="#52b788"/>
          <rect x="17" y="20" width="2" height="9" rx="1" fill="#c9a84c"/>
        </svg>
      </div>
      <div class="logo-text">
        <span class="logo-main">TD Handy Man</span>
        <span class="logo-sub">Australia</span>
      </div>
    </a>

    <!-- Nav Links -->
    <ul class="nav-links" id="nav-links">
      <li><a href="/" class="nav-link <%= page === 'home' ? 'active' : '' %>" id="nav-home">Home</a></li>
      <li><a href="/services" class="nav-link <%= page === 'services' ? 'active' : '' %>" id="nav-services">Services</a></li>
      <li><a href="/gallery" class="nav-link <%= page === 'gallery' ? 'active' : '' %>" id="nav-gallery">Gallery</a></li>
      <li><a href="/about" class="nav-link <%= page === 'about' ? 'active' : '' %>" id="nav-about">About</a></li>
      <li><a href="/contact" class="nav-link nav-cta <%= page === 'contact' ? 'active' : '' %>" id="nav-contact">Get a Quote</a></li>
    </ul>

    <!-- Hamburger -->
    <button class="hamburger" id="hamburger" aria-label="Toggle menu" aria-expanded="false">
      <span></span><span></span><span></span>
    </button>
  </div>
</nav>
