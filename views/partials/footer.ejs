<style>
  @keyframes premium-pulse {
    0% { box-shadow: 0 0 0 0 rgba(255, 255, 255, 0.8), 0 10px 25px rgba(8, 23, 84, 0.2); }
    70% { box-shadow: 0 0 0 20px rgba(255, 255, 255, 0), 0 10px 25px rgba(8, 23, 84, 0.2); }
    100% { box-shadow: 0 0 0 0 rgba(255, 255, 255, 0), 0 10px 25px rgba(8, 23, 84, 0.2); }
  }
  .phone-premium {
    position: fixed; bottom: 30px; right: 30px; z-index: 1000;
    width: 65px; height: 65px; border-radius: 50%;
    display: flex; align-items: center; justify-content: center;
    background: #ffffff;
    border: 1px solid rgba(8,23,84,0.1);
    box-shadow: 0 10px 25px rgba(8, 23, 84, 0.2);
    animation: premium-pulse 2.5s infinite;
    transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
  }
  .phone-premium:hover {
    transform: scale(1.1) rotate(8deg);
    box-shadow: 0 15px 35px rgba(8, 23, 84, 0.3);
  }
  .phone-premium svg {
    filter: drop-shadow(0px 2px 4px rgba(0,0,0,0.3));
  }
</style>
